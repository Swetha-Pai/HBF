name: Custom.Linux.Search.BinaryFiles
description: |
  Search all files recursively and return files that are binary (executables, libraries, etc).

precondition:
  SELECT * FROM info() WHERE OS = 'linux'

parameters:
  - name: SearchFilesGlob
    default: /home/*
    description: Use a glob to define the files that will be searched.

  - name: SearchFilesGlobTable
    type: csv
    default: |
      Glob
      /**
    description: Alternative specify multiple globs in a table

  - name: Upload_File
    default: N
    type: bool

  - name: Calculate_Hash
    default: N
    type: bool

  - name: ExcludePathRegex
    default: "^/(proc|sys|run|snap)"
    type: regex

  - name: LocalFilesystemOnly
    default: Y
    type: bool

  - name: OneFilesystem
    default: N
    type: bool

  - name: DoNotFollowSymlinks
    type: bool
    default: N

sources:
- query: |
    LET LocalDeviceMajor <= (
       253, 7, 8, 9, 11,
       65, 66, 67, 68, 69, 70, 71,
       128,129,130,131,132,133,134,135,
       202, 254, 259
    )

    LET RecursionCallback = if(
       condition=LocalFilesystemOnly,
         then=if(condition=ExcludePathRegex,
                 then="x=>x.Data.DevMajor IN LocalDeviceMajor AND NOT x.OSPath =~ ExcludePathRegex",
                 else="x=>x.Data.DevMajor IN LocalDeviceMajor"),
         else=if(condition=ExcludePathRegex,
                 then="x=>NOT x.OSPath =~ ExcludePathRegex",
                 else=""))

    LET file_search = SELECT OSPath, Sys.mft as Inode, Mode.String AS Mode, Size,
               Mtime AS MTime, Atime AS ATime, Ctime AS CTime, IsDir, Mode, Data
        FROM glob(globs=SearchFilesGlobTable.Glob + SearchFilesGlob,
                  recursion_callback=RecursionCallback,
                  one_filesystem=OneFilesystem,
                  accessor="file",
                  nosymlink=DoNotFollowSymlinks)
        WHERE Mode.IsRegular

    LET binaries = SELECT OSPath, Inode, Mode, Size, ATime, MTime, CTime,
               magic(path=OSPath, accessor="file") AS Magic
        FROM file_search
        WHERE Magic.mime_type =~ "application/x-executable|application/x-sharedlib|application/x-object|application/octet-stream"

    SELECT OSPath, Inode, Mode, Size, ATime, MTime, CTime, Magic.mime_type AS MimeType,
        if(condition=Upload_File and Mode.IsRegular,
           then=upload(file=OSPath, accessor="file")) AS Upload,
        if(condition=Calculate_Hash and Mode.IsRegular,
           then=hash(path=OSPath, accessor="file")) AS Hash
    FROM binaries

column_types:
  - name: ATime
    type: timestamp
  - name: MTime
    type: timestamp
  - name: CTime
    type: timestamp
  - name: Upload
    type: preview_upload
