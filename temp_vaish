name: Find.NonStandard.Extensions
description: |
    Detects files without standard extensions to identify potential suspicious or unknown files.
    Recursively scans the filesystem, excluding files with common extensions.

type: CLIENT

parameters:
  - name: RootPath
    default: /
    description: Root path to begin the file search.

sources:
  - precondition: |
      SELECT OS FROM info() WHERE OS = 'linux'

    query: |
      LET files = SELECT OSPath, Size, MTime
      FROM glob(
          globs=RootPath + "/**",
          recursion_callback="x => x",
          one_filesystem=true,
          accessor="file",
          nosymlink=true
      )
      WHERE NOT IsDir

      LET files_with_ext = foreach(row=files,
          SELECT
              row.OSPath AS FullPath,
              row.Size AS Size,
              row.MTime AS MTime,
              regex(source=row.OSPath, pattern="\\.([a-zA-Z0-9]+)$") AS ExtensionMatch
          FROM scope()
      )

      SELECT
          FullPath,
          ExtensionMatch.group(1) AS Extension,
          Size,
          MTime
      FROM files_with_ext
      WHERE NOT ExtensionMatch.group(1) IN (
          "txt", "log", "csv", "xml", "json", "yaml", "yml",
          "jpg", "jpeg", "png", "gif", "bmp", "ico",
          "mp3", "wav", "mp4", "avi", "mov", "mkv",
          "zip", "tar", "gz", "bz2", "7z", "rar",
          "doc", "docx", "xls", "xlsx", "ppt", "pptx", "pdf",
          "exe", "dll", "bat", "msi", "com",
          "sh", "bash", "py", "rb", "pl", "ps1", "js", "php", "go",
          "so", "out", "ko", "bin", "apk",
          "conf", "ini", "cfg", "desktop",
          "db", "sqlite", "bak", "md",
          "html", "htm", "css", "scss", "ts",
          "icns", "dmg", "pkg", "app",
          "c", "cpp", "java", "class"
      )
