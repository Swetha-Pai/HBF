rule Suspicious_ELF_Binary
{
    meta:
        description = "Detects ELF binaries that could be malicious"
        mitre_ttp = "T1204.002, T1059"

    strings:
        $a = { 7F 45 4C 46 }      // ELF magic header
        $b = "/bin/sh" ascii nocase
        $c = "socket" ascii
        $d = "connect" ascii
        $e = "execve" ascii

    condition:
        $a at 0 and (#b + #c + #d + #e) > 2
}

rule Suspicious_Shell_Script
{
    meta:
        description = "Detects shell scripts containing dangerous commands"
        mitre_ttp = "T1059.004"

    strings:
        $a = "nc -e" ascii
        $b = "bash -i" ascii
        $c = "0<&196;exec 196<>/dev/tcp/" ascii
        $d = "/bin/bash -i >& /dev/tcp/" ascii
        $e = "curl " ascii
        $f = "wget " ascii

    condition:
        (any of ($a,$b,$c,$d)) or (all of ($e,$f))
}
