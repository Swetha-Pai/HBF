name: Custom.Linux.Search.UncommonExtensions

description: |
  Recursively search the filesystem for files with uncommon file extensions.
  Useful for identifying potentially suspicious or unusual files not matching known/expected types.

precondition:
  SELECT * FROM info() where OS = 'linux'

parameters:
  - name: SearchFilesGlob
    default: /home/*
    description: Use a glob to define the files that will be searched.

  - name: SearchFilesGlobTable
    type: csv
    default: |
      Glob
      /**
    description: Alternative to specify multiple globs in a table

  - name: ExcludePathRegex
    default: "^/(proc|sys|run|snap|dev|tmp|var/tmp)"
    type: regex
    description: Skip these directories entirely during search.

  - name: LocalFilesystemOnly
    default: Y
    type: bool
    description: Only search local disks, skip remote or virtual filesystems.

  - name: OneFilesystem
    default: N
    type: bool
    description: Avoid crossing filesystem boundaries.

  - name: DoNotFollowSymlinks
    type: bool
    default: Y
    description: Do not follow symbolic links when globbing.

sources:
- query: |
    LET CommonExtensions = SELECT * FROM parse_csv_string(
    """
    Extension
    sh
    bash
    zsh
    conf
    cfg
    ini
    service
    log
    sock
    pid
    out
    bin
    so
    ko
    mod
    kmod
    rules
    udev
    mount
    fstab
    sysctl
    deb
    rpm
    gz
    bz2
    xz
    tar
    tgz
    zip
    zst
    c
    cpp
    h
    o
    py
    pl
    rb
    go
    js
    ts
    json
    yaml
    yml
    xml
    md
    txt
    sql
    db
    sqlite
    pem
    crt
    key
    csr
    pub
    passwd
    group
    shadow
    hosts
    resolv
    hostname
    nsswitch
    bashrc
    profile
    bash_profile
    ld_so_conf
    ld_so_cache
    html
    css
    jpg
    jpeg
    png
    gif
    svg
    mp4
    mp3
    mpg
    avi
    mov
    flac
    pdf
    odt
    ods
    odp
    desktop
    mime
    locale
    swap
    swp
    tmp
    bak
    """
    )

    LET LocalDeviceMajor <= (
       253,
       7, 8, 9, 11,
       65, 66, 67, 68, 69, 70, 71,
       128, 129, 130, 131, 132, 133, 134, 135,
       202, 253, 254, 259
    )

    LET RecursionCallback = if(
       condition=LocalFilesystemOnly,
       then=if(condition=ExcludePathRegex,
               then="x=>x.Data.DevMajor IN LocalDeviceMajor AND NOT x.OSPath =~ ExcludePathRegex",
               else="x=>x.Data.DevMajor IN LocalDeviceMajor"),
       else=if(condition=ExcludePathRegex,
               then="x=>NOT x.OSPath =~ ExcludePathRegex",
               else="")
    )

    LET file_search = SELECT OSPath,
           Sys.mft AS Inode,
           Mode.String AS Mode,
           Size,
           Mtime AS MTime,
           Atime AS ATime,
           Ctime AS CTime,
           IsDir,
           Mode,
           Data,
           regex_search(pattern="\\.([^.\\/]+)$", str=OSPath).Group(1) AS Extension
      FROM glob(globs=SearchFilesGlobTable.Glob + SearchFilesGlob,
                recursion_callback=RecursionCallback,
                one_filesystem=OneFilesystem,
                accessor="file",
                nosymlink=DoNotFollowSymlinks)
      WHERE Mode.IsRegular
        AND Extension != ""
        AND NOT Extension IN CommonExtensions.Extension

    SELECT OSPath, Extension, Size, MTime, ATime, CTime FROM file_search

column_types:
  - name: ATime
    type: timestamp
  - name: MTime
    type: timestamp
  - name: CTime
    type: timestamp
