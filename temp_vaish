name: Find.NonStandard.Extensions
description: |
    Detects files without standard extensions to identify potential suspicious/unknown files.
    Recursively scans filesystem excluding common extensions (.txt, .exe, etc.).

type: CLIENT

parameters:
    - name: RootPath
      default: /
      description: Root path to begin the file search.

sources:
    - precondition: |
        SELECT OS FROM info() WHERE OS = 'linux'

      query: |
        LET file_search = SELECT 
            OSPath, 
            Size, 
            MTime,
            regex(
                source=OSPath, 
                pattern="\\.([a-zA-Z0-9]+)$"
            ) AS ExtensionMatch
        FROM glob(
            globs=RootPath + "/**",
            recursion_callback="x => x",
            one_filesystem=true,
            accessor="file",
            nosymlink=true
        )
        WHERE NOT IsDir

        LET filtered = SELECT 
            OSPath AS FullPath,
            ExtensionMatch.group(1) AS Extension,
            Size,
            MTime
        FROM file_search
        WHERE NOT ExtensionMatch.group(1) IN (
            "txt", "log", "csv", "xml", "json", "yaml", "yml",
            "jpg", "jpeg", "png", "gif", "bmp", "ico",
            "mp3", "wav", "mp4", "avi", "mov", "mkv",
            "zip", "tar", "gz", "bz2", "7z", "rar",
            "doc", "docx", "xls", "xlsx", "ppt", "pptx", "pdf",
            "exe", "dll", "bat", "msi", "com",
            "sh", "bash", "py", "rb", "pl", "ps1", "js", "php", "go",
            "so", "out", "ko", "bin", "apk",
            "conf", "ini", "cfg", "desktop",
            "db", "sqlite", "bak", "md",
            "html", "htm", "css", "scss", "ts",
            "icns", "dmg", "pkg", "app",
            "c", "cpp", "java", "class"
        )

        SELECT * FROM filtered
