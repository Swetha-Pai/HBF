name: Find.NonStandard.Extensions
description: |
  This artifact detects files on the system that do not have standard extensions, allowing you to find suspicious or unknown file types that might be present.
  It recursively scans the file system for files that do NOT have common extensions (e.g., .txt, .exe, etc.).

type: CLIENT

parameters:
  - name: RootPath
    default: /
    description: Root path to begin the file search.

sources:
  - precondition: |
      SELECT OS FROM info() WHERE OS = 'linux'

    query: |
      LET file_search = SELECT OSPath, Size, MTime,
        regex(OSPath, "\\.([a-zA-Z0-9]+)$") AS ExtensionMatch
      FROM glob(
        globs=RootPath + "/**",
        recursion_callback="x => x",
        one_filesystem=true,
        accessor="file",
        nosymlink=true
      )
      WHERE NOT IsDir

      LET filtered = SELECT 
        OSPath AS FullPath,
        ExtensionMatch.group(1) AS Extension,
        Size,
        MTime
      FROM file_search
      WHERE NOT ExtensionMatch.group(1) IN (
        "txt", "jpg", "jpeg", "png", "gif", "bmp", "pdf", "doc", "docx",
        "xls", "xlsx", "csv", "html", "htm", "xml", "zip", "tar", "gz", "rar",
        "mp4", "mp3", "mov", "avi", "mkv", "exe", "dll", "sh", "bat", "py",
        "js", "php", "c", "cpp", "java", "class", "go", "rb"
      )

      SELECT * FROM filtered
