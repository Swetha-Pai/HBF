name: Custom.Detection.CommandLineDownloads
description: |
  Detects wget/curl downloads via shell history analysis
  with proper multi-platform support.

parameters:
  - name: HistoryPaths
    default: |
      /*.history
      /*_history
      /home/*/.*_history
      /root/.*_history
      C:\\Users\\*\\AppData\\Roaming\\Microsoft\\Windows\\PowerShell\\*\\History*

sources:
  - query: |
      LET history_files = SELECT OSPath, Mtime, Username
        FROM glob(globs=split(string=HistoryPaths, sep="\n"))
        WHERE Size > 0

      SELECT * FROM foreach(
        row=history_files,
        query={
          SELECT OSPath,
            Mtime,
            Username,
            Line as CommandLine,
            regex_replace(
              source=Line,
              re=".*(curl\s+-[oO]|wget\s+-[O]).*",
              replace="$1"
            ) AS DownloadCommand
          FROM parse_lines(filename=OSPath, accessor="auto")
          WHERE DownloadCommand
        })
