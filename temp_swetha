name: Custom.Detection.CommandLineDownloads
description: |
  Strict detection of wget/curl download commands with output flags (-O/-o)

parameters:
  - name: HistoryPaths
    default: |
      /home/*/.*_history
      /root/.*_history
      C:\\Users\\*\\AppData\\Roaming\\Microsoft\\Windows\\PowerShell\\*\\History*

sources:
  - query: |
      LET history_files = SELECT OSPath, Mtime, Username
        FROM glob(globs=split(string=HistoryPaths, sep="\n"))
        WHERE Size > 0

      SELECT * FROM foreach(
        row=history_files,
        query={
          SELECT OSPath,
            Mtime,
            Username,
            Line AS FullCommand,
            regex_replace(
              source=Line,
              re='(wget\s+.*?(-O\s|--output-document\s)|curl\s+.*?(-o\s|--output\s))',
              replace="$1"
            ) AS DownloadCommand
          FROM parse_lines(filename=OSPath, accessor="auto")
          WHERE 
            Line =~ '(\bwget\b.*(-O\s|--output-document\s)|curl\b.*(-o\s|--output\s))'
            AND NOT Line =~ "(\\?[a-zA-Z0-9_]+=)"  // Exclude parameterized URLs
        })
